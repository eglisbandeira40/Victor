# Servidor
PORT=3000

# Postgres - connection string do banco (Supabase: Settings > Database > Connection string, use a
# "session" pooler URI; EasyPanel: connection string interna do servico de banco, ex "fiado-db")
DATABASE_URL=postgresql://user:password@host:5432/postgres

# WhatsApp Business Cloud API (Meta for Developers)
WHATSAPP_TOKEN=coloque_o_token_permanente_aqui
WHATSAPP_PHONE_NUMBER_ID=coloque_o_phone_number_id_aqui
WHATSAPP_VERIFY_TOKEN=escolha_uma_string_secreta_para_verificacao_do_webhook
# Opcional no schema, mas OBRIGATORIO em producao: sem isso, qualquer um pode mandar POST fake pro
# seu /webhook se souber a URL. Pega em Meta for Developers > seu App > Configuracoes basicas > App Secret.
WHATSAPP_APP_SECRET=

# Anthropic (Claude)
ANTHROPIC_API_KEY=coloque_sua_api_key_aqui
ANTHROPIC_MODEL=claude-haiku-4-5

# Message Templates aprovados pela Meta, pra mensagens proativas (resumo semanal, alerta de cobranca,
# lembrete de vencimento) funcionarem fora da janela de 24h de conversa. Sem eles, esses 3 jobs caem
# pra texto livre, que a Meta rejeita se o comerciante nao mandou mensagem nas ultimas 24h.
# Ver README > "Mensagens proativas (Message Templates)" pros textos prontos pra submeter.
WHATSAPP_TEMPLATE_LANGUAGE=pt_BR
WHATSAPP_TEMPLATE_WEEKLY_SUMMARY=
WHATSAPP_TEMPLATE_COLLECTION_ALERT=
WHATSAPP_TEMPLATE_DUE_REMINDER=
WHATSAPP_TEMPLATE_PLAN_RENEWAL_WARNING=
WHATSAPP_TEMPLATE_PLAN_EXPIRED=

# Contato de suporte mostrado quando o trial do comerciante vence (usado so se PIX_KEY estiver vazia).
# Ex: "wa.me/5511999998888" (WhatsApp) ou "suporte@fiado.app" (e-mail).
SUPPORT_CONTACT=

# Chave Pix mostrada direto na mensagem de trial vencido (com valor do plano incluso), pra pagar sem
# precisar chamar o suporte primeiro. So usada se ASAAS_API_KEY (abaixo) estiver vazia.
PIX_KEY=

# Opcional - cobranca Pix automatica via Asaas. Preenchendo as duas, o Fiado gera uma cobranca Pix real
# quando o trial vence e libera o acesso sozinho quando o pagamento confirmar (via webhook), sem
# precisar rodar /internal/set-plan na mao. Ver README > "Pagamento automatico (Asaas)".
# API Key: asaas.com > Configuracoes > Integracoes > API Key
ASAAS_API_KEY=
# Token que voce escolhe e cadastra tambem no Asaas (Configuracoes > Integracoes > Webhooks > Token de
# autenticacao) - valida que o webhook realmente veio do Asaas.
ASAAS_WEBHOOK_TOKEN=

# Numero do WhatsApp do admin/dono do Fiado (so digitos, com codigo do pais, sem "+"). Qualquer
# mensagem vinda desse numero abre o menu admin (nao entra no fluxo normal de comerciante) e ele
# recebe aviso automatico de comerciante novo e de trial vencendo. Ver README > "Menu admin".
ADMIN_WHATSAPP_PHONE=5511958762003

# Opcional - comando por voz. Sem preencher, o Fiado avisa pra mandar por texto quando recebe audio.
# Preenchendo essa key, o comando por voz ativa sozinho (nao precisa mexer em mais nada no codigo).
# Pega em platform.openai.com/api-keys.
OPENAI_API_KEY=
