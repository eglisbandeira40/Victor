# Servidor
PORT=3000

# Postgres (Supabase -> Settings > Database > Connection string, use a "session" pooler URI)
DATABASE_URL=postgresql://user:password@host:5432/postgres

# WhatsApp Business Cloud API (Meta for Developers)
WHATSAPP_TOKEN=coloque_o_token_permanente_aqui
WHATSAPP_PHONE_NUMBER_ID=coloque_o_phone_number_id_aqui
WHATSAPP_VERIFY_TOKEN=escolha_uma_string_secreta_para_verificacao_do_webhook
# Opcional, mas recomendado em producao: App Secret para validar a assinatura do webhook
WHATSAPP_APP_SECRET=

# Anthropic (Claude)
ANTHROPIC_API_KEY=coloque_sua_api_key_aqui
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Message Templates aprovados pela Meta, pra mensagens proativas (resumo semanal, alerta de cobranca,
# lembrete de vencimento) funcionarem fora da janela de 24h de conversa. Sem eles, esses 3 jobs caem
# pra texto livre, que a Meta rejeita se o comerciante nao mandou mensagem nas ultimas 24h.
# Ver README > "Mensagens proativas (Message Templates)" pros textos prontos pra submeter.
WHATSAPP_TEMPLATE_LANGUAGE=pt_BR
WHATSAPP_TEMPLATE_WEEKLY_SUMMARY=
WHATSAPP_TEMPLATE_COLLECTION_ALERT=
WHATSAPP_TEMPLATE_DUE_REMINDER=
